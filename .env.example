# Senha de acesso ao app (OBRIGATÓRIO trocar)
APP_PASSWORD=troque-esta-senha

PORT=3000
DB_PATH=./data/paopuro.db
TZ_APP=America/Sao_Paulo

# --- Telegram (grátis) ---
# Token do robô criado no @BotFather. Com ele definido, o app mostra o botão "Conectar meu Telegram".
TELEGRAM_BOT_TOKEN=

# Provedor de WhatsApp: callmebot | zapi | meta | evolution | console (só mostra no log)
WHATSAPP_PROVIDER=console

# --- CallMeBot (grátis) ---
# Cada número tem a sua chave, cadastrada no app (Ajustes) como "(11) 98765-4321 = 123456".
# Opcional: chave padrão para números cadastrados sem "= chave"
CALLMEBOT_APIKEY=

# --- Meta (WhatsApp Cloud API oficial) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Modelo aprovado com 3 variáveis no corpo: {{1}} qtde de boletos, {{2}} total, {{3}} lista
META_TEMPLATE_NAME=contas_vencendo_hoje
META_TEMPLATE_LANG=pt_BR

# --- Z-API ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Evolution API ---
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
